# Stage 1 uses only in-memory deterministic enrichment; no secrets are required.

# Stage 2: bounded AI-assisted investigation configuration.
# Default provider is "mock" - deterministic, offline, no credentials needed.
# A fresh clone works out of the box without any of the settings below.
AI_PROVIDER=mock
AI_PROVIDER_TIMEOUT_SECONDS=8

# Bounds the live provider's built-in retry policy for transient failures
# (connection errors, timeouts, HTTP 429/5xx). Not used by the mock provider.
AI_LIVE_MAX_RETRIES=2

# Maximum accepted size (bytes) of a POST /api/v1/alerts request body.
# Optional - defaults to 262144 (256 KiB) if unset.
MAX_ALERT_BODY_BYTES=262144

# Only needed if AI_PROVIDER selects a live provider (requires installing the
# optional `live-ai` extra: `uv sync --extra live-ai`). Never commit a real key.
ANTHROPIC_API_KEY=

# Structured JSON log verbosity. One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
# Optional - defaults to INFO if unset or unrecognized. See docs/operations.md.
LOG_LEVEL=INFO

# Mock-backed threat-intelligence enrichment integration (Sprint 2). Both
# have safe, non-secret defaults - the provider talks to a mocked HTTP
# transport, not a real vendor. See docs/integration-architecture.md.
THREAT_INTEL_BASE_URL=https://mock-threat-intel.example/v1
THREAT_INTEL_API_KEY=mock-threat-intel-api-key

# Read timeout and bounded retry count for the threat-intel integration
# client. Optional - defaults shown. See docs/adr/002-provider-resilience.md.
THREAT_INTEL_TIMEOUT_SECONDS=5
THREAT_INTEL_MAX_RETRIES=2

# Selects which enrichment provider the running application uses. Default
# "mock" is fully offline, deterministic, and requires no other settings.
# Any other value attempts the mock-backed threat-intel integration above;
# see app/main.py: select_enrichment_provider.
ENRICHMENT_PROVIDER=mock
THREAT_INTEL_MAX_RETRIES=2
